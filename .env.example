PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Product image uploads (Cloudinary) — required for the admin
# "choose image from computer" upload flow. Get these from your
# Cloudinary dashboard (Settings > API Keys). CLOUDINARY_API_SECRET
# must never be committed or sent to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
